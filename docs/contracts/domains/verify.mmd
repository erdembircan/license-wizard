---
title: Verify Domain — Contract
---
classDiagram
  direction TB

  %% Domain: Verify (src root)
  %% Focused per-domain view extracted from ../class-diagram.mmd.
  %% Shows ONLY Verify-domain classes and their intra-domain relationships.
  %% Cross-domain relationships (LicenseWizard creates the verifier; the verifier
  %% reads Configuration, re-renders through Licensing, reads the LICENSE file)
  %% are intentionally omitted — see ../class-diagram.mmd for the full picture.

  class LicenseVerifier {
    +LicenseVerifier(config: Config, manifests: ProjectManifestRepository, generator: LicenseGenerator, reader: IFileSystemReader, repository: LicenseRepository)
    +verify(options: VerifyOptions) Promise~VerifyOutcome~
  }

  class VerifyOptions {
    +fix: boolean
  }

  class VerifyOutcome {
    <<union>>
  }

  class VerifyReport {
    +licenseId: string
    +license: DriftStatus
    +manifests: ManifestCheck[]
    +builtFrom: LicenseRenderBasis
    +licenseDifference: TextDifference | null
    +tokens: TokenCheck
    +configFile: string | null
    +fullHeaders: boolean
  }

  class ManifestCheck {
    +name: string
    +declared: string | null
    +status: DriftStatus
  }

  class DriftStatus {
    <<union>>
  }

  class TokenCheck {
    +saved: string[]
    +unknown: string[]
    +fields: string[]
  }

  class TextDifference {
    +line: number
    +column: number
    +found: string | null
    +expected: string | null
  }

  class firstDifference {
    <<function>>
    +firstDifference(found: string, expected: string) TextDifference | null
  }

  LicenseVerifier ..> VerifyOptions : configured by
  LicenseVerifier ..> VerifyOutcome : returns
  LicenseVerifier ..> firstDifference : locates LICENSE drift with
  VerifyOutcome ..> VerifyReport : carries
  VerifyReport ..> ManifestCheck : aggregates
  VerifyReport ..> DriftStatus : statuses by
  VerifyReport ..> TokenCheck : checks saved tokens with
  VerifyReport ..> TextDifference : pinpoints LICENSE drift with
  ManifestCheck ..> DriftStatus : status by
  firstDifference ..> TextDifference : produces
